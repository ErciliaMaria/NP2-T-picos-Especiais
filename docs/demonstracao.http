# Use o Swagger ou o cliente HTTP do IntelliJ.
# Substitua os IDs abaixo pelos retornados nos cadastros; não suponha que serão 1.
@base = http://localhost:8080
@autorId = 1
@alunoId = 1
@livroId = 1
@emprestimoId = 1
@avaliacaoId = 1

### Cadastrar autor — 201
POST {{base}}/api/authors
Content-Type: application/json

{"nome":"Machado de Assis","nacionalidade":"Brasileira","dataNascimento":"1839-06-21","biografia":"Autor de Dom Casmurro"}

### Cadastrar aluno — 201
POST {{base}}/api/students
Content-Type: application/json

{"nome_completo":"Ana Silva","matricula":"DEMO-001","turma":"2A","dataNascimento":"2009-03-12"}

### Cadastrar livro vinculado ao autor — 201
POST {{base}}/api/books
Content-Type: application/json

{"titulo":"Dom Casmurro","autor":"Machado de Assis","autorId":{{autorId}},"editora":"Editora Exemplo","anoPublicacao":1899,"quantidadeExemplares":3}

### Cadastrar empréstimo — 201
POST {{base}}/api/loans
Content-Type: application/json

{"alunoId":{{alunoId}},"livroId":{{livroId}},"dataEmprestimo":"2026-11-06","dataPrevistaDevolucao":"2026-11-13","dataDevolucao":null,"observacoes":"Livro em bom estado"}

### Registrar devolução por edição — 200
PUT {{base}}/api/loans/{{emprestimoId}}
Content-Type: application/json

{"alunoId":{{alunoId}},"livroId":{{livroId}},"dataEmprestimo":"2026-11-06","dataPrevistaDevolucao":"2026-11-13","dataDevolucao":"2026-11-06","observacoes":"Devolvido em bom estado"}

### Cadastrar avaliação — 201
POST {{base}}/api/reviews
Content-Type: application/json

{"alunoId":{{alunoId}},"livroId":{{livroId}},"titulo":"Boa leitura","nota":5,"comentario":"Gostei da história.","dataAvaliacao":"2026-11-06"}

### Listar autores — 200
GET {{base}}/api/authors

### Consultar autor — 200
GET {{base}}/api/authors/{{autorId}}

### Editar autor — 200
PUT {{base}}/api/authors/{{autorId}}
Content-Type: application/json

{"nome":"Machado de Assis","nacionalidade":"Brasileira","dataNascimento":"1839-06-21","biografia":"Romancista brasileiro"}

### Listar empréstimos — 200
GET {{base}}/api/loans

### Consultar empréstimo — 200
GET {{base}}/api/loans/{{emprestimoId}}

### Listar avaliações — 200
GET {{base}}/api/reviews

### Consultar avaliação — 200
GET {{base}}/api/reviews/{{avaliacaoId}}

### Editar avaliação — 200
PUT {{base}}/api/reviews/{{avaliacaoId}}
Content-Type: application/json

{"alunoId":{{alunoId}},"livroId":{{livroId}},"titulo":"Boa leitura","nota":4,"comentario":"Recomendo a leitura.","dataAvaliacao":"2026-11-06"}

### Nota inválida — 400
POST {{base}}/api/reviews
Content-Type: application/json

{"alunoId":{{alunoId}},"livroId":{{livroId}},"titulo":"Teste","nota":6,"comentario":"Teste de validação","dataAvaliacao":"2026-11-06"}

### Livro vinculado a empréstimo/avaliação — 409
DELETE {{base}}/api/books/{{livroId}}

### Funcionalidade extra: importar por ISBN — 200 (repetido: 409)
POST {{base}}/api/books/import/9780140328721

### Excluir avaliação — 204
DELETE {{base}}/api/reviews/{{avaliacaoId}}

### Excluir empréstimo — 204
DELETE {{base}}/api/loans/{{emprestimoId}}

### Excluir livro após remover vínculos — 200
DELETE {{base}}/api/books/{{livroId}}

### Excluir aluno após remover vínculos — 200
DELETE {{base}}/api/students/{{alunoId}}

### Excluir autor após remover livro — 204
DELETE {{base}}/api/authors/{{autorId}}

### Consultar autor excluído — 404
GET {{base}}/api/authors/{{autorId}}
